# --- Source: the current live Supabase project ---
SUPABASE_URL=
# Service role key, NOT the anon key — needed to read every row, bypassing RLS.
# Get it from Supabase dashboard → Project Settings → API → service_role.
# Never commit this. Rotate it once the migration is done and verified.
SUPABASE_SERVICE_ROLE_KEY=

# --- Destination: RDS ---
# Preferred: a Secrets Manager secret (same one backend/.env's AWS_SECRET_NAME points at)
AWS_SECRET_NAME=gyftr/tech-portal/db
AWS_REGION=ap-south-1
# Fallback if AWS_SECRET_NAME is unset
DB_HOST=
DB_PORT=5432
DB_NAME=gyftr_tech_portal
DB_USER=
DB_PASSWORD=

# --- Cognito (create-cognito-users.mjs only) ---
COGNITO_USER_POOL_ID=
COGNITO_REGION=ap-south-1
# Every created user gets this permanent password — matches the app's
# one-click profile picker, which authenticates with this same password
# behind the scenes for whichever name is clicked.
DEFAULT_PASSWORD=default@123

# --- smoke-test.mjs / doctor.js ---
API_URL=
FRONTEND_URL=
COGNITO_CLIENT_ID=
SMOKE_TEST_EMAIL=

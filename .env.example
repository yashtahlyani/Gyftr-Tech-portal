# Root .env — used by `docker-compose up` (frontend build args + backend
# env_file). For plain `npm run dev` outside Docker, only the VITE_* vars
# below matter; leave them blank to run in local demo mode (data persists
# in the browser instead of talking to a real backend).

# --- Frontend (baked in at build time) ---
VITE_API_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# --- Backend (see backend/.env.example for the full list + comments) ---
PORT=4000
FRONTEND_URL=http://localhost:4173
# AWS_SECRET_NAME=gyftr/tech-portal/db
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=gyftr_tech_portal
DB_USER=
DB_PASSWORD=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-south-1

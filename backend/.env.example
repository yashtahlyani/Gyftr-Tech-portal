# Copy to backend/.env for local development, or set these on the ECS task
# definition. Never commit .env — this repository is public.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8978
FRONTEND_URL=https://tech.gyftr.net

# ── Database (RDS Postgres) — used only if AWS_SECRET_NAME is unset ──────────
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=gyftr_tech
DB_USER=gyftr_admin
DB_PASSWORD=your_db_password

# ── Optional: pull DB credentials from Secrets Manager instead of DB_* above ──
# If set, the DB_* vars above are ignored. This is the production path — it
# keeps the password out of the task definition, where it would otherwise be
# readable by anyone with ecs:DescribeTaskDefinition.
# AWS_SECRET_NAME=gyftr/tech/db
# AWS_REGION=ap-south-1

# ── AWS Cognito ───────────────────────────────────────────────────────────────
# middleware/auth.js exits at boot without these two. No separate region
# variable is needed here — aws-jwt-verify derives it from the pool id's
# ap-south-1_... prefix.
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_cognito_app_client_id

# ── S3 (private bucket for attachment metadata, optional) ────────────────────
# Must have Block Public Access fully enabled. Attachments are link-only
# without this set — see backend/s3.js and backend/routes/attachments.js.
ATTACHMENTS_BUCKET=gyftr-tech-portal-attachments

# HTTP port the API listens on
PORT=4000

# Origin allowed to call this API (the CloudFront/S3 frontend URL)
FRONTEND_URL=https://portal.example.com

# --- Database ---
# Preferred: name of a Secrets Manager secret holding
# { "host": "...", "port": 5432, "database": "...", "username": "...", "password": "..." }
AWS_SECRET_NAME=gyftr-tech-portal/rds

# Fallback (used only if AWS_SECRET_NAME is unset) — direct connection env vars
PGHOST=
PGPORT=5432
PGDATABASE=gyftr_tech_portal
PGUSER=
PGPASSWORD=

# --- Cognito (for verifying JWTs on every request) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-south-1

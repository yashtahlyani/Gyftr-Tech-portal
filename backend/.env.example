# HTTP port the API listens on
PORT=4000

NODE_ENV=development

# Origin allowed to call this API (the CloudFront/S3 or ECS-served frontend URL)
FRONTEND_URL=https://techportal.gyftr.net

AWS_REGION=ap-south-1

# --- Database ---
# Preferred (production default — baked into the Dockerfile): name of a
# Secrets Manager secret holding
# { "host": "...", "port": 5432, "dbname": "...", "username": "...", "password": "..." }
# AWS_SECRET_NAME=gyftr/tech-portal/db

# Fallback (used only if AWS_SECRET_NAME is unset) — direct connection env
# vars for local/dev, e.g. against docker-compose's host Postgres.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=gyftr_tech_portal
DB_USER=
DB_PASSWORD=

# --- Cognito (for verifying JWTs on every request) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-south-1

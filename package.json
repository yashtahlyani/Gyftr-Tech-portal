{
  "name": "gyftr-tech-portal",
  "private": true,
  "version": "2.0.0",
  "description": "Gyftr Tech Portal — React frontend + Express API on AWS (ECS/RDS/Cognito/S3)",
  "type": "module",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend && npm install --prefix scripts",
    "test": "node --test \"tests/*.test.mjs\"",
    "seed": "npm --prefix scripts run seed",
    "onboard": "npm --prefix scripts run onboard",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "doctor": "npm --prefix scripts run doctor"
  }
}
